# Root env — read by docker-compose.yml. Copy to `.env` and fill in.
# Per-service variables live in each service's own .env.example.

# --- database (api-gateway) ---
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/subasa

# --- api-gateway ---
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# The gateway refuses to start if this is missing, a known placeholder, or
# (with APP_ENV=production) shorter than 32 characters.
JWT_SECRET=
APP_ENV=development
# Public origin the gateway builds absolute URLs from (e.g. TTS audio links).
# Leave blank to derive it from the request's Host header.
PUBLIC_BASE_URL=

# Google Sign-In client ID the ID token is verified against. Must match the
# frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- CORS, applied to every backend service ---
# Comma-separated explicit origins. "*" is rejected at startup.
CORS_ALLOW_ORIGINS=http://localhost:7007,http://localhost:5173

# --- models ---
# Hugging Face token used by the ASR and TTS containers to pull checkpoints.
ASR_HF_TOKEN=
TTS_HF_TOKEN=

# --- LLM (chatbot-modified, framework) ---
GROQ_API_KEY=

# --- rate limiting on the metered /api proxy (0 disables) ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- monitoring ---
GRAFANA_ADMIN_PASSWORD=
