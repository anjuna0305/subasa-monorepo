# Gateway base URL.
VITE_API_BASE_URL=https://api.subasa.lk

# Sub-path the SPA is served under (vite `base`). Use "" or "/" at the root.
VITE_BASE_PATH=/voc-si

# Google Sign-In client ID (must match the gateway's GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Optional. Overrides the OAuth redirect URI; defaults to the app's own origin.
VITE_GOOGLE_REDIRECT_URI=

# url_path of the custom chatbot backing the /p/gov-chatbot page.
VITE_GOV_CHATBOT_PATH=gov-chatbot
