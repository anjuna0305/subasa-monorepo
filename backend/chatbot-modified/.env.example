GROQ_API_KEY=

# Redis caches the serialised FAISS index per retrieval_key.
REDIS_HOST=redis
REDIS_PORT=6379

# Where the gateway's uploaded knowledge files are mounted.
UPLOAD_DIR=/usr/src/app/uploaded_files

# Explicit origins only, comma-separated. "*" is rejected at startup.
CORS_ALLOW_ORIGINS=http://localhost:7007,http://localhost:5173
