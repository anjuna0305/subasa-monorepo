DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/subasa

# Required. No fallback value exists — the app raises at startup without it.
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# development | production. production turns weak-config warnings into
# startup failures.
APP_ENV=development

# Explicit origins only, comma-separated. "*" is rejected.
CORS_ALLOW_ORIGINS=http://localhost:7007,http://localhost:5173

# Upload root. IMAGE_UPLOAD_DIR and FILE_UPLOAD_DIR default to
# <UPLOAD_DIR>/chatbot_images and <UPLOAD_DIR>/chatbot_files; override
# individually only if they must live apart.
UPLOAD_DIR=./uploads
# IMAGE_UPLOAD_DIR=
# FILE_UPLOAD_DIR=
# Where generated TTS audio is cached for /tts/output/{file}.
FILE_STORE_DIR=./uploads/tts

# Downstream services (ports match docker-compose.yml).
CUSTOM_CHATBOT_SERVICE_URL=http://localhost:7006/chat
TTS_SERVICE_URL=http://localhost:7002
ASR_SERVICE_URL=http://localhost:7000
FRAMEWORK_SERVICE_URL=http://localhost:7003

# Absolute base URL used in responses; blank falls back to the request Host.
PUBLIC_BASE_URL=

# Google Sign-In: the client ID the ID token is verified against.
GOOGLE_CLIENT_ID=
