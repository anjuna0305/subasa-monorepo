# Copy to .env and restart the dev server (Expo inlines EXPO_PUBLIC_* at build time).

# API gateway, for chatbot lookup, chat and TTS.
# Use a LAN IP, not localhost — localhost on a phone is the phone itself.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:7010

# url_path of the chatbot this build opens, e.g. sri-lanka-constitution
EXPO_PUBLIC_CHATBOT_PATH=

# ASR, called directly like the web client does. No API key.
# Defaults to https://subasa.lk/voc-si/api/asr/transcribe
# EXPO_PUBLIC_ASR_TRANSCRIBE_URL=http://192.168.1.10:7000/transcribe

# Optional TTS voice overrides
# EXPO_PUBLIC_TTS_SPEAKER=mettananda
# EXPO_PUBLIC_TTS_VOICE=male
