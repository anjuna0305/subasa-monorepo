# Copy to .env and restart the dev server (Expo inlines EXPO_PUBLIC_* at build time).

# API gateway, for chatbot lookup, chat and TTS.
EXPO_PUBLIC_API_BASE_URL=https://subasa.lk/voc-si/api/api-gateway
# Against a local stack instead, use a LAN IP — localhost on a phone is the phone itself.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:7010

# url_path of the chatbot this build opens, e.g. sri-lanka-constitution.
# It has to be a published chatbot; the gateway returns 503 for an unpublished one.
EXPO_PUBLIC_CHATBOT_PATH=

# ASR, called directly like the web client does. No API key. The gateway's metered proxy
# (/api/{service_key}/{path}) is not finished yet.
# Defaults to https://subasa.lk/voc-si/api/asr/transcribe
# EXPO_PUBLIC_ASR_TRANSCRIBE_URL=http://192.168.1.10:7000/transcribe

# Sentence-by-sentence streaming needs /tts/prepare and /tts/stream on the gateway, which
# are not deployed yet — subasa.lk currently 404s on them. Keep this false until the
# gateway is redeployed, then drop the line to start playback after the first sentence.
EXPO_PUBLIC_TTS_STREAMING=false

# Optional TTS voice overrides
# EXPO_PUBLIC_TTS_SPEAKER=mettananda
# EXPO_PUBLIC_TTS_VOICE=male
